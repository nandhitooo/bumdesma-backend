# Server
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bumdesma_absensi
DB_USER=postgres
DB_PASSWORD=postgres
DB_DIALECT=postgres

# JWT
JWT_SECRET=ubah_dengan_secret_key_yang_kuat_dan_acak
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=ubah_dengan_secret_key_refresh_yang_berbeda
JWT_REFRESH_EXPIRES_IN=7d

# Geofencing default (Kantor BUMDESMA Podo Rukun LKD)
OFFICE_LATITUDE=-7.123456
OFFICE_LONGITUDE=112.123456
GEOFENCE_RADIUS_METERS=50

# Jadwal kerja default
WORK_START_TIME=08:30
WORK_END_TIME=15:00
LATE_TOLERANCE_MINUTES=15
SATURDAY_START_TIME=09:00
SATURDAY_END_TIME=12:00

# === Tambahkan blok ini ke .env backend (bumdesma-backend/.env) ===
# Dipakai untuk mengirim kode OTP reset password ke email pemulihan karyawan.
#
# Contoh untuk Gmail (paling gampang untuk dev/testing):
#   1. Aktifkan 2-Step Verification di akun Google pengirim.
#   2. Buat "App Password" di https://myaccount.google.com/apppasswords
#      (bukan password akun Gmail biasa).
#   3. Isi SMTP_USER dengan alamat Gmail itu, SMTP_PASSWORD dengan App
#      Password 16 karakter yang di-generate.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=alamat-pengirim@gmail.com
SMTP_PASSWORD=app_password_16_karakter
SMTP_FROM="BUMDESMA Podo Rukun LKD <alamat-pengirim@gmail.com>"

# Kalau pakai provider SMTP lain (mis. Mailtrap untuk testing, atau SMTP
# kantor/hosting), tinggal ganti HOST/PORT/USER/PASSWORD sesuai kredensial
# provider tersebut. SMTP_SECURE=true kalau providernya pakai port 465 (SSL).